---
import '../styles/global.css';
import '../styles/enhancements.css';
import '../styles/cinematic.css';
import FocusSelector from '../components/FocusSelector.astro';
import CinematicSequence from '../components/CinematicSequence.astro';
import { getImage } from 'astro:assets';
import pathways from '../assets/consulting-pathways.png';

const aboutArtwork = await getImage({ src: pathways, format: 'webp', width: 900, quality: 82 });
---
<!doctype html>
<html lang="de-AT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#0b1727">
  <meta name="description" content="Tayfun Dereyurt verbindet KI, Daten und bestehende Anwendungen zu nachvollziehbaren Verbesserungen für österreichische Mittelbetriebe.">
  <title>Tayfun Dereyurt — AI, Data & Digital Transformation</title>
  <style define:vars={{ artworkUrl: `url('${aboutArtwork.src}')` }}>
    .about-art { background-image: linear-gradient(180deg, rgba(8, 24, 37, .1), rgba(8, 24, 37, .25)), var(--artworkUrl); background-size: cover; background-position: center; }
  </style>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230b1727'/%3E%3Cpath d='M15 20h34M32 20v25M20 45h24' fill='none' stroke='%2369d5c8' stroke-width='5' stroke-linecap='round'/%3E%3C/svg%3E">
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  <header class="site-header" id="site-header">
    <div class="shell header-inner">
      <a class="brand" href="#start" aria-label="Tayfun Dereyurt, zur Startseite"><span class="brand-mark" aria-hidden="true">TD<span>.</span></span><span class="brand-name">Tayfun Dereyurt</span></a>
      <nav aria-label="Hauptnavigation" class="desktop-nav"><a href="#leistungen">Leistungen</a><a href="#arbeitsweise">Arbeitsweise</a><a href="#ueber-mich">Über mich</a></nav>
      <details class="mobile-nav"><summary>Menü <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile Navigation"><a href="#ausgangslage">Ausgangslage</a><a href="#leistungen">Leistungen</a><a href="#arbeitsweise">Arbeitsweise</a><a href="#ueber-mich">Über mich</a><a href="#faq">FAQ</a><a href="#kontakt">Kontakt</a></nav></details>
      <a class="header-cta" href="#kontakt">Erstgespräch <span aria-hidden="true">↗</span></a>
    </div>
    <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
  </header>
  <main id="inhalt">
    <section class="hero" id="start" aria-labelledby="hero-title">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Unabhängige Beratung · Salzburg &amp; Oberösterreich</p>
          <h1 id="hero-title">Aus Daten und KI wird erst dann Fortschritt, <em>wenn es im Alltag funktioniert.</em></h1>
          <p class="hero-lead">Ich helfe Unternehmen, Daten, KI und bestehende Anwendungen sinnvoll zu verbinden — mit nachvollziehbarem Nutzen, einer tragfähigen Grundlage und klarer Umsetzung.</p>
          <div class="hero-actions"><a class="button button-primary" href="#kontakt">Erstgespräch vereinbaren <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="#leistungen">Leistungen ansehen <span aria-hidden="true">↓</span></a></div>
          <p class="hero-note">Für Mittelbetriebe in ganz Österreich. Persönlich, pragmatisch, unabhängig.</p>
        </div>
        <div class="hero-visual" aria-label="Schematische Darstellung: Daten und bestehende Anwendungen führen über Integration zu nutzbaren Entscheidungen" role="img">
          <div class="visual-topline"><span>VON KOMPLEXITÄT ZU KLARHEIT</span><span class="visual-indicator">SCHEMATISCHES MODELL</span></div>
          <div class="flow-node source source-a"><span class="node-icon">▦</span><span>Bestehende<br>Anwendungen</span></div>
          <div class="flow-node source source-b"><span class="node-icon">◫</span><span>Daten &amp;<br>Reporting</span></div>
          <div class="flow-line line-a"></div><div class="flow-line line-b"></div>
          <div class="flow-core"><span class="core-orbit orbit-one"></span><span class="core-orbit orbit-two"></span><span class="core-center">TD<span>∙</span></span></div>
          <div class="flow-line line-c"></div>
          <div class="flow-node outcome"><span class="outcome-tag">ERGEBNIS</span><strong>Klare Entscheidungen.<br>Wirksame Prozesse.</strong><span class="outcome-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
          <div class="visual-footer"><span>01 / VERSTEHEN</span><span>02 / VERBINDEN</span><span>03 / VERBESSERN</span></div>
        </div>
      </div>
      <div class="shell hero-bottom"><span>AI, DATA &amp; DIGITAL TRANSFORMATION</span><span>SCROLLEN, UM MEHR ZU ERFAHREN <b aria-hidden="true">↓</b></span></div>
    </section>
    <section class="context-section section-pad" id="ausgangslage" aria-labelledby="context-title">
      <div class="shell context-grid">
        <div class="section-intro"><p class="section-kicker"><span>01</span> AUSGANGSLAGE</p><h2 id="context-title">Viele Systeme. Viele Daten. <span>Zu wenig Verbindung.</span></h2><p>Im Mittelstand fehlt selten die nächste Idee. Häufiger fehlt ein klarer Weg vom heutigen Prozess zu einer Lösung, die im Betrieb Bestand hat.</p></div>
        <div class="challenge-list" role="list">
          <div class="challenge" role="listitem"><span class="challenge-num">01</span><div><h3>Informationen liegen verteilt</h3><p>Wichtige Kennzahlen entstehen in unterschiedlichen Anwendungen, Dateien und Definitionen.</p></div><span class="challenge-arrow" aria-hidden="true">↗</span></div>
          <div class="challenge" role="listitem"><span class="challenge-num">02</span><div><h3>Manuelle Arbeit bremst</h3><p>Wiederkehrende Prüfungen, Übertragungen und Abstimmungen kosten Zeit und erhöhen das Fehlerrisiko.</p></div><span class="challenge-arrow" aria-hidden="true">↗</span></div>
          <div class="challenge" role="listitem"><span class="challenge-num">03</span><div><h3>Gewachsene Anwendungen werden zur Hürde</h3><p>Neue Anforderungen treffen auf bestehende Schnittstellen, Abhängigkeiten und Zuständigkeiten.</p></div><span class="challenge-arrow" aria-hidden="true">↗</span></div>
          <div class="challenge" role="listitem"><span class="challenge-num">04</span><div><h3>KI-Potenzial bleibt unklar</h3><p>Zwischen einer guten Demo und einem sicheren, nützlichen Einsatz im Alltag liegt oft die eigentliche Arbeit.</p></div><span class="challenge-arrow" aria-hidden="true">↗</span></div>
        </div>
      </div>
    </section>

    <CinematicSequence />

    <section class="services-section section-pad" id="leistungen" aria-labelledby="services-title">
      <div class="shell"><div class="section-heading"><div><p class="section-kicker"><span>02</span> LEISTUNGEN</p><h2 id="services-title">Vom Potenzial zur <span>belastbaren Lösung.</span></h2></div><p>Vier Einstiegspunkte — je nachdem, wo Sie heute stehen und welches Ergebnis Sie brauchen.</p></div>
      <div class="service-grid">
        <article id="service-ai-check" class="service-card"><div class="service-top"><span class="service-number">01 / ORIENTIERUNG</span><span class="service-icon" aria-hidden="true">◎</span></div><h3>AI Readiness &amp;<br>Use-Case-Check</h3><p>Wir prüfen Prozesse, Datenlage und mögliche KI-Anwendungen. Der Fokus liegt auf sinnvollen Einsatzfeldern, nicht auf Technologie um ihrer selbst willen.</p><div class="service-result"><span>ERGEBNIS</span><strong>Priorisierte Use Cases, erste Einschätzung zu Nutzen und Machbarkeit, konkreter nächster Schritt.</strong></div></article>
        <article id="service-sprint" class="service-card"><div class="service-top"><span class="service-number">02 / UMSETZUNG</span><span class="service-icon" aria-hidden="true">↗</span></div><h3>AI- und<br>Automatisierungssprints</h3><p>Ein klar abgegrenzter Anwendungsfall wird umgesetzt — etwa Dokumentenverarbeitung, interne Wissenssuche oder die Entlastung repetitiver Abläufe.</p><div class="service-result"><span>WORAUF ES ANKOMMT</span><strong>Integration, Zugriffskontrollen, menschliche Prüfung und ein messbarer Nutzen im Prozess.</strong></div></article>
        <article id="service-data" class="service-card"><div class="service-top"><span class="service-number">03 / DATENBASIS</span><span class="service-icon" aria-hidden="true">▥</span></div><h3>Daten, Reporting<br>&amp; Analytics</h3><p>Von gemeinsamen KPI-Definitionen und Datenmodellen bis zur Modernisierung von Reports und Self-Service-Analytics.</p><div class="service-result"><span>ERGEBNIS</span><strong>Verlässliche Zahlen und bessere Entscheidungen. Gute Dashboards beginnen bei der Datenbasis.</strong></div></article>
        <article id="service-product" class="service-card"><div class="service-top"><span class="service-number">04 / PRODUKT</span><span class="service-icon" aria-hidden="true">◇</span></div><h3>Applikations- &amp;<br>Product-Consulting</h3><p>Unterstützung bei Anforderungen, Roadmaps, Schnittstellen, Modernisierung und der Steuerung externer Partner.</p><div class="service-result"><span>MEIN BEITRAG</span><strong>Eine klare Verbindung zwischen Fachbereich, Management und IT — von der Idee bis zum Betrieb.</strong></div></article>
      </div>
      <FocusSelector />
      <p class="services-note">Verantwortungsvolle KI-Einführung und Governance fließen bei Bedarf in diese Arbeit ein. Ich unterstütze organisatorisch und technisch; Rechtsberatung oder Zertifizierung biete ich nicht an.</p></div>
    </section>

    <section class="approach-section section-pad" id="arbeitsweise" aria-labelledby="approach-title"><div class="shell"><div class="approach-head"><div><p class="section-kicker light"><span>03</span> ARBEITSWEISE</p><h2 id="approach-title">Klarer Weg. <span>Kontrollierte Umsetzung.</span></h2></div><p>Jede Zusammenarbeit beginnt beim tatsächlichen Geschäftsproblem. Technik wird erst dann eingesetzt, wenn ihr Beitrag klar ist.</p></div><div class="steps" role="list"><article class="step" role="listitem"><span class="step-count">01</span><div class="step-line"></div><h3>Verstehen</h3><p>Ziele, Abläufe, Systeme, Daten und Beteiligte erfassen. Die Ausgangslage sichtbar machen.</p></article><article class="step" role="listitem"><span class="step-count">02</span><div class="step-line"></div><h3>Priorisieren</h3><p>Nutzen, Aufwand und Risiken abwägen. Einen sinnvollen ersten Schritt festlegen.</p></article><article class="step" role="listitem"><span class="step-count">03</span><div class="step-line"></div><h3>Umsetzen</h3><p>Eine Lösung in bestehende Prozesse integrieren — mit klaren Verantwortlichkeiten und Kontrollen.</p></article><article class="step" role="listitem"><span class="step-count">04</span><div class="step-line"></div><h3>Wirkung prüfen</h3><p>Ergebnis im Alltag bewerten, Rückmeldungen aufnehmen und gezielt weiterentwickeln.</p></article></div></div></section>

    <section class="about-section section-pad" id="ueber-mich" aria-labelledby="about-title"><div class="shell about-grid"><div class="about-art" aria-hidden="true"><div class="about-art-grid"></div><span class="about-monogram">TD<span>.</span></span><div class="about-art-caption"><span>BUSINESS</span><i></i><span>TECHNOLOGIE</span></div></div><div class="about-copy"><p class="section-kicker"><span>04</span> ÜBER MICH</p><h2 id="about-title">Ich übersetze zwischen <span>Geschäft und Technologie.</span></h2><p class="about-lead">Ich bin Tayfun Dereyurt. In meiner Arbeit verbinde ich die Sicht von Management und Fachbereichen mit den Anforderungen an verlässliche IT-Systeme.</p><p>Als IT DevOps Cloud Expert im Finanzdienstleistungsumfeld habe ich Verantwortung für geschäftskritische Finanz- und Versicherungsapplikationen übernommen — von Product Ownership und Lifecycle bis zur Zusammenarbeit mit externen Entwicklungspartnern und internationalen Stakeholdern.</p><p>Meine Ausbildung in Informationstechnik und Systemmanagement sowie ein Masterabschluss in Data Science und Adaptive Software Systems bilden die fachliche Grundlage. Dazu kommen Erfahrungen mit Datenplattformen, Reporting, Cloud-Architektur, Daten-Governance und KI-gestützter Prozessverbesserung.</p><div class="about-tags" aria-label="Kompetenzfelder"><span>Product Ownership</span><span>Daten &amp; Analytics</span><span>Cloud &amp; APIs</span><span>KI &amp; Automatisierung</span></div></div></div></section>

    <section class="examples-section section-pad" id="projektbeispiele" aria-labelledby="examples-title"><div class="shell"><div class="section-heading"><div><p class="section-kicker"><span>05</span> ERFAHRUNGSFELDER</p><h2 id="examples-title">Erfahrung aus <span>komplexen Umgebungen.</span></h2></div><p>Diese Themen beschreiben meine berufliche Erfahrung allgemein und anonymisiert. Sie sind keine Kundenreferenzen oder zugesagten Projektergebnisse.</p></div><div class="example-grid"><article class="example-card"><span class="example-label">DATEN &amp; REPORTING</span><div class="example-symbol" aria-hidden="true"><span></span><span></span><span></span></div><h3>Gewachsene Reporting-Landschaften ordnen</h3><p>Arbeit an gemeinsamen Definitionen, Datenmodellen und der Harmonisierung von Berichten über mehrere Bereiche hinweg.</p></article><article class="example-card"><span class="example-label">PLATTFORM &amp; APPLIKATIONEN</span><div class="example-symbol symbol-link" aria-hidden="true"><span></span><span></span><span></span></div><h3>Bestehende Systeme weiterentwickeln</h3><p>Lifecycle-Verantwortung für geschäftskritische Anwendungen sowie Abstimmung von Roadmaps, Schnittstellen und Partnern.</p></article><article class="example-card"><span class="example-label">KI &amp; PROZESSE</span><div class="example-symbol symbol-spark" aria-hidden="true">✳</div><h3>KI dort prüfen, wo sie Arbeit verbessert</h3><p>Konzeption und Umsetzung von Ansätzen zur Analyse und Validierung von Anforderungen und Datenmodellen.</p></article></div><p class="example-footnote">Konkrete Fallstudien und Kennzahlen werden erst nach Freigabe veröffentlicht.</p></div></section>

    <section class="faq-section section-pad" id="faq" aria-labelledby="faq-title"><div class="shell faq-grid"><div><p class="section-kicker"><span>06</span> HÄUFIGE FRAGEN</p><h2 id="faq-title">Gut zu wissen, <span>bevor wir sprechen.</span></h2><p class="faq-intro">Sie haben eine andere Frage? Im Erstgespräch klären wir, ob und wie ich unterstützen kann.</p></div><div class="faq-list"><details><summary>Wie groß muss ein Projekt sein?<span aria-hidden="true">+</span></summary><p>Ein klar abgegrenzter Check oder Sprint ist ebenso möglich wie eine längerfristige Begleitung. Entscheidend ist ein konkretes Ziel und ein sinnvoller Umfang für den nächsten Schritt.</p></details><details><summary>Wie arbeiten wir zusammen?<span aria-hidden="true">+</span></summary><p>Ich arbeite direkt mit den verantwortlichen Personen in Fachbereich, Management und IT. Ziele, Zuständigkeiten und Zwischenergebnisse werden zu Beginn geklärt.</p></details><details><summary>Was gilt für Datenschutz und sensible Daten?<span aria-hidden="true">+</span></summary><p>Datenschutz, Zugriffskontrollen und menschliche Prüfung werden bei der Lösungsplanung berücksichtigt. Für rechtliche Bewertungen werden die zuständigen Expert:innen eingebunden.</p></details><details><summary>Müssen bestehende Systeme ersetzt werden?<span aria-hidden="true">+</span></summary><p>In vielen Fällen ist das nicht nötig. Zuerst prüfen wir, welche Anwendungen und Schnittstellen bereits vorhanden sind und wo eine gezielte Ergänzung den größten Nutzen bringt.</p></details><details><summary>Was passiert im Erstgespräch?<span aria-hidden="true">+</span></summary><p>Wir besprechen Ihre Ausgangslage, das gewünschte Ergebnis und mögliche nächste Schritte. Das Gespräch ist unverbindlich.</p></details></div></div></section>

    <section class="contact-section section-pad" id="kontakt" aria-labelledby="contact-title"><div class="shell contact-grid"><div class="contact-copy"><p class="section-kicker light"><span>07</span> KONTAKT</p><h2 id="contact-title">Lassen Sie uns über <span>den nächsten sinnvollen Schritt</span> sprechen.</h2><p>Ob eine konkrete KI-Idee, unklare Datenlage oder eine gewachsene Anwendung: Beschreiben Sie kurz Ihr Anliegen. Wir finden heraus, was jetzt wirklich hilft.</p><div class="contact-location"><span class="location-dot"></span><span>Schwerpunkt Salzburg &amp; Oberösterreich<br><small>Projekte in ganz Österreich möglich</small></span></div><div class="contact-email"><span>E-MAIL</span><strong>E-Mail-Adresse wird ergänzt</strong><small>Kontaktdaten stehen noch nicht zur Verfügung.</small></div></div><div class="form-panel"><h3>Anfrage vorbereiten</h3><p>Der Versand ist noch nicht eingerichtet. Sie können Ihre Anfrage hier formulieren und als Text kopieren.</p><form id="contact-form"><div class="form-row"><label>Ihr Name<input name="name" autocomplete="name" required placeholder="Vor- und Nachname"></label><label>Ihre E-Mail<input type="email" name="email" autocomplete="email" required placeholder="name@unternehmen.at"></label></div><label>Ihr Anliegen<textarea name="message" rows="5" required placeholder="Worum geht es und welches Ergebnis wünschen Sie sich?"></textarea></label><button class="button button-primary form-submit" type="submit">Anfrage vorbereiten <span aria-hidden="true">↗</span></button><p class="form-privacy">Ihre Angaben bleiben in Ihrem Browser. Dieses Formular versendet und speichert keine Daten.</p></form><div id="prepared-message" class="prepared-message" hidden><label for="prepared-text">Ihre vorbereitete Anfrage</label><textarea id="prepared-text" readonly rows="8"></textarea><button type="button" id="copy-message" class="copy-button">Text kopieren</button><p id="copy-status" role="status" aria-live="polite"></p></div></div></div></section>
  </main>
  <footer class="site-footer"><div class="shell footer-top"><div><a class="brand footer-brand" href="#start"><span class="brand-mark" aria-hidden="true">TD<span>.</span></span><span class="brand-name">Tayfun Dereyurt</span></a><p>AI, Data &amp; Digital Transformation<br>Unabhängige Beratung in Österreich</p></div><div class="footer-links"><a href="#leistungen">Leistungen</a><a href="#arbeitsweise">Arbeitsweise</a><a href="#ueber-mich">Über mich</a><a href="#kontakt">Kontakt</a></div></div><div class="shell footer-bottom"><span>© <span id="year">2026</span> Tayfun Dereyurt</span><div><button type="button" data-dialog="impressum-dialog">Impressum</button><button type="button" data-dialog="privacy-dialog">Datenschutz</button><button type="button" data-dialog="cookies-dialog">Cookie-Einstellungen</button><span class="footer-placeholder">LinkedIn-Link wird ergänzt</span></div></div></footer>
  <dialog id="impressum-dialog" class="legal-dialog" aria-labelledby="impressum-title"><div class="dialog-head"><h2 id="impressum-title">Impressum</h2><button type="button" class="dialog-close" aria-label="Schließen">×</button></div><p class="legal-placeholder">Musterangaben für die private Vorschau – kein gültiges Impressum.</p><p>Beispielunternehmen · Musterstraße 1 · 0000 Musterstadt · E-Mail: kontakt@example.invalid</p><p>Vor einer öffentlichen Freigabe werden diese Angaben durch die tatsächlichen Pflichtangaben ersetzt.</p></dialog>
  <dialog id="privacy-dialog" class="legal-dialog" aria-labelledby="privacy-title"><div class="dialog-head"><h2 id="privacy-title">Datenschutz</h2><button type="button" class="dialog-close" aria-label="Schließen">×</button></div><p class="legal-placeholder">Musterhinweis für die private Vorschau – keine vollständige Datenschutzerklärung.</p><p>Das Kontaktformular bereitet Text ausschließlich in Ihrem Browser vor. Es sendet und speichert Ihre Eingaben nicht. Für den Betrieb der Website können beim Hosting technische Zugriffsdaten anfallen. Verantwortliche Stelle, Hosting-Anbieter und weitere erforderliche Angaben werden vor einer öffentlichen Freigabe ergänzt und geprüft.</p></dialog>
  <dialog id="cookies-dialog" class="legal-dialog" aria-labelledby="cookies-title"><div class="dialog-head"><h2 id="cookies-title">Cookie-Einstellungen</h2><button type="button" class="dialog-close" aria-label="Schließen">×</button></div><p>Diese Erstversion setzt keine Analyse- oder Marketing-Cookies und lädt keine Drittanbieter-Einbettungen. Daher gibt es derzeit keine optionalen Cookie-Kategorien zur Auswahl.</p><p>Wenn später Dienste ergänzt werden, werden die Einstellungen hier entsprechend erweitert.</p></dialog>
  <script is:inline src="./interactions.js" defer></script>
</body>
</html>
